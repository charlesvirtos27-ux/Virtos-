<section class="wrap section narrow">
  <header class="page-head"><h1>{{ page.title }}</h1></header>
  <div class="rte">{{ page.content }}</div>
  {%- form 'contact', class: 'contact-form' -%}
    {%- if form.posted_successfully? -%}<p class="ok">{{ 'contact.sent' | t }}</p>{%- endif -%}
    {%- if form.errors -%}<p class="err">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label for="c-name">{{ 'contact.name' | t }}</label><input id="c-name" name="contact[name]" required autocomplete="name">
    <label for="c-email">{{ 'general.email' | t }}</label><input id="c-email" type="email" name="contact[email]" required autocomplete="email">
    <label for="c-sub">{{ 'contact.subject' | t }}</label><input id="c-sub" name="contact[subject]">
    <label for="c-msg">{{ 'contact.message' | t }}</label><textarea id="c-msg" name="contact[body]" rows="6" required></textarea>
    <button class="btn" type="submit">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</section>
<script>(function(){var s=new URLSearchParams(location.search).get('subject');var i=document.getElementById('c-sub');if(i){i.value=s?{{ 'contact.about' | t | json }}+' '+s:'';}})();</script>
{% schema %}{ "name": "Contact" }{% endschema %}
